# Every key is optional. Without them the app runs fully on local fallbacks.

# Google Gemini — schedule negotiation + backtracking reflection
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest  (falls back through newer flash models; 2.5 is closed to new keys)

# ElevenLabs — Tilly's voice (falls back to the browser's speech synthesis)
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Neon Postgres — tables are created and seeded automatically on first request
# DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
